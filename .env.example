# Server-only local fixture CLI. Copy to .env.local (never commit values).
# Browser configuration is read from /api/config; never use VITE_ for secrets.
APP_ENV=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Local-only test automation (do not commit passwords):
TEST_BUYER_A_EMAIL=buyer-a@example.test
TEST_BUYER_B_EMAIL=buyer-b@example.test
TEST_BUYER_A_PASSWORD=
TEST_BUYER_B_PASSWORD=
# Empty passwords are generated securely in ignored .fixtures/test-users.env.
